# Environment variables and secrets
.env
.env.local
.env.*.local

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Python Bytecode, Distribution & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
dist/
build/
*.egg-info/

# User Uploaded Documents (ignore dynamically uploaded files, preserve test fixtures and .gitkeep)
backend/uploads/doc_*
backend/uploads/*.tmp
!backend/uploads/.gitkeep

# FAISS Vector Database Indexes (ignore generated indexes, preserve .gitkeep)
backend/vector_store/doc_*
backend/vector_store/test_*
!backend/vector_store/.gitkeep

# SQLite Database Files
*.db
*.sqlite
*.sqlite3
backend/models/*.db

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Distributable Archives
*.zip
*.tar.gz
