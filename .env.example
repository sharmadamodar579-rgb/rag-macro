# =====================================================================
# AI College Study Assistant — Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# DO NOT commit your actual .env file with secrets into version control.
# =====================================================================

# ---------------------------------------------------------------------
# Option A: OpenRouter AI Provider (Free model routing)
# ---------------------------------------------------------------------
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------
# Option B: Google Gemini AI Provider
# ---------------------------------------------------------------------
# AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_or_openrouter_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Flask Application Settings
# In production, set FLASK_DEBUG=False and FLASK_ENV=production
FLASK_ENV=development
FLASK_DEBUG=False

# Cryptographic Secret Key (Used for secure session cookie signing)
# In production, generate a secure random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secure-random-secret-key-change-me

# Security & CORS Settings
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_SECONDS=604800

# Database Connection (Default: SQLite database inside backend/models/)
# DATABASE_URL=sqlite:///models/app.db

# Storage Directories (Defaults inside backend/)
# UPLOAD_FOLDER=backend/uploads
# VECTOR_STORE_FOLDER=backend/vector_store
